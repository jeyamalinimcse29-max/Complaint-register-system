  "field_definitions": {
    "record_id": "Unique identifier for each cleaning or complaint record. Format: REC followed by 3 digits.",
    "block_id": "Identifier for the toilet block. Used to group records by location.",
    "location": "Name or description of where the toilet block is situated.",
    "cleaning_date": "Date when the block was cleaned, in YYYY-MM-DD format. May be null if cleaning was not recorded.",
    "cleaner": "Name of the person who performed the cleaning. May be 'Unknown' if not recorded.",
    "complaint_text": "Description of the complaint. Null if the record is only a cleaning visit with no complaint.",
    "complaint_date": "Date when the complaint was received, in YYYY-MM-DD format. Null if no complaint.",
    "status": "Current status of the record. Values: 'cleaned' (cleaned, no complaint), 'pending' (complaint received, awaiting action), 'resolved' (complaint addressed)."
  }
